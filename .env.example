# Beckon Daemon Configuration
# Copy this file to .env and adjust variables as needed

# Network Binding
# 127.0.0.1 (default) listens only on loopback for local browser extension
# 0.0.0.0 (or running daemon with --lan) exposes the daemon to companion devices on LAN
BECKON_HOST=127.0.0.1
BECKON_PORT=8765

# Security Token (shared secret between clients and daemon)
BECKON_AUTH_TOKEN=change_me_to_a_secure_token

# Speech-to-Text (faster-whisper)
# Models: tiny (fastest), base (light CPU), small (recommended for accents / multilingual code-switching)
BECKON_MODEL=small
BECKON_DEVICE=cpu
BECKON_COMPUTE_TYPE=int8
BECKON_THREADS=4
# Constrain speech recognition to your allowed languages (e.g. en,bn,hi or en,es or en,de)
# This prevents Whisper from misclassifying short/noisy audio into random global languages (e.g. pl, ml)
BECKON_LANGUAGES=en,bn,hi
# Minimum word probability threshold (rejects low-confidence hallucinations)
BECKON_MIN_WORD_CONFIDENCE=0.40

# Catch-Up Notification Summarization (Tier 3)
# Uses fast LLM to convert raw transcribed snippets into a clean 1-sentence alert notification
# Groq free tier (~300ms latency, zero audio leaves device):
# BECKON_GROQ_API_KEY=gsk_your_groq_api_key_here
# BECKON_SUMMARY_MODEL=llama-3.1-8b-instant
# Or local Ollama:
# BECKON_OLLAMA_URL=http://localhost:11434

# Target Identifier Profile (Dynamic)
# Left empty by default so identity is dynamically registered by the active client (Chrome Extension / Android App)
# Fallback defaults:
BECKON_TARGET_NAME=
BECKON_ALIASES=
BECKON_SENSITIVITY=balanced

