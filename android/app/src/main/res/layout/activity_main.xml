<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- 1. Top Masthead Bar (Persistent) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Beckon logo"
                android:src="@drawable/ic_beckon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.02"
                        android:text="Beckon"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="monospace"
                        android:text="DAEMON"
                        android:textColor="@color/accent_green"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.04"
                    android:text="ON-DEVICE LISTENER"
                    android:textColor="@color/text_tertiary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/badgeEngineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_chip_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="11dp"
            android:paddingBottom="5dp">

            <View
                android:id="@+id/dotEngineStatus"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot_circle"
                android:backgroundTint="@color/accent_red" />

            <TextView
                android:id="@+id/tvEngineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:text="OFFLINE"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:id="@+id/dividerTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/topBar"
        android:background="@color/border_subtle" />

    <!-- 2. Bottom Navigation Dock (Persistent) -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#0C0D10"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabListener"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabListener"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Listener"
                android:src="@drawable/ic_nav_listener"
                app:tint="@color/accent_green" />

            <TextView
                android:id="@+id/tvTabListener"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Listener"
                android:textColor="@color/accent_green"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabDaemon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivTabDaemon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Daemon Config"
                android:src="@drawable/ic_nav_daemon"
                app:tint="@color/text_tertiary" />

            <TextView
                android:id="@+id/tvTabDaemon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="Daemon"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dividerBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/bottomDock"
        android:background="@color/border_subtle" />

    <!-- 3. Page Container (Swappable between Listener and Daemon) -->
    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/dividerBottom"
        android:layout_below="@+id/dividerTop">

        <!-- ================= PAGE 1: LISTENER (SHAZAM HERO SCREEN) ================= -->
        <ScrollView
            android:id="@+id/pageListener"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- Top Sub-Bar: Target Name Chip (left) & Floating Mode toggle (right) -->
                <LinearLayout
                    android:id="@+id/shazamTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Name Chip: Click to change -->
                    <LinearLayout
                        android:id="@+id/btnChangeTargetName"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_chip_pill"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/accent_green" />

                        <TextView
                            android:id="@+id/tvShazamTargetName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Mayukh"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="▾"
                            android:textColor="@color/text_tertiary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Floating HUD Toggle -->
                    <TextView
                        android:id="@+id/btnToggleFloating"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_chip_pill"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="HUD: OFF"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Center Hero Container (Shazam Style) -->
                <LinearLayout
                    android:id="@+id/shazamHeroContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvShazamTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.02"
                        android:text="Tap to Beckon"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <TextView
                        android:id="@+id/tvShazamSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="36dp"
                        android:fontFamily="sans-serif"
                        android:text="Hears your name and alerts you instantly"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- Giant Circular Shazam Button -->
                    <FrameLayout
                        android:layout_width="220dp"
                        android:layout_height="220dp">

                        <!-- Outer Pulse Ring View (Animated when listening) -->
                        <View
                            android:id="@+id/viewShazamPulseRing"
                            android:layout_width="220dp"
                            android:layout_height="220dp"
                            android:background="@drawable/bg_dot_circle"
                            android:backgroundTint="#2610B981"
                            android:visibility="gone" />

                        <!-- Intermediate Ring View -->
                        <View
                            android:id="@+id/viewShazamMidRing"
                            android:layout_width="190dp"
                            android:layout_height="190dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_dot_circle"
                            android:backgroundTint="#331E293B" />

                        <!-- Inner Button -->
                        <RelativeLayout
                            android:id="@+id/btnShazamHero"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_shazam_button"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/ivShazamIcon"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_centerInParent="true"
                                android:src="@drawable/ic_beckon" />
                        </RelativeLayout>
                    </FrameLayout>

                    <!-- Status Indicator below button -->
                    <TextView
                        android:id="@+id/tvShazamStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/bg_chip_pill"
                        android:fontFamily="monospace"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp"
                        android:text="IDLE • TAP CIRCLE TO START"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Hidden / backward-compat elements needed by service bindings -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">
                    <Button android:id="@+id/btnStartListening" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <EditText android:id="@+id/etTargetNamesDashboard" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <View android:id="@+id/llEqualizerBars" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <View android:id="@+id/eqBar1" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <View android:id="@+id/eqBar2" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <View android:id="@+id/eqBar3" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <View android:id="@+id/eqBar4" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvActiveKeywordsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/btnMiuiPopups" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Bottom Auto-Detect & Server IP Pill -->
                <LinearLayout
                    android:id="@+id/bottomControlSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Recent Alerts (pops up when alerts occur) -->
                    <LinearLayout
                        android:id="@+id/llAlertsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical" />

                    <!-- 1-Tap Auto Scan IP Pill -->
                    <LinearLayout
                        android:id="@+id/btnAutoScanIp"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_chip_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔍"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvCurrentIpDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="monospace"
                            android:text="192.168.29.102:8765"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvScanLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif"
                            android:text="(Tap to Auto-Detect)"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>
        </ScrollView>
        <!-- ================= PAGE 2: DAEMON CONFIG (TECHNICAL PAGE) ================= -->
        <ScrollView
            android:id="@+id/pageDaemon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <!-- 1. Local Daemon Node Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Local Daemon Node"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="monospace"
                                android:text="SOCKET READY"
                                android:textColor="@color/accent_green"
                                android:textSize="10sp" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etServerIp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_input_field"
                                android:fontFamily="monospace"
                                android:importantForAutofill="no"
                                android:inputType="textUri"
                                android:paddingStart="12dp"
                                android:paddingTop="10dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="10dp"
                                android:hint="192.168.1.100:8765"
                                android:text="192.168.1.100:8765"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTestPing"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:backgroundTint="@color/bg_elevated"
                                android:fontFamily="sans-serif-medium"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Ping"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp"
                                app:cornerRadius="8dp"
                                app:strokeColor="@color/border_subtle"
                                app:strokeWidth="1dp" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/tvPingResult"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="Wi-Fi link to PC engine"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="monospace"
                                android:text="TCP · 8765"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AI Catch-Up Summaries Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummarizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="AI Catch-Up Summaries"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvGroqStatusTag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_chip_tag"
                                android:fontFamily="monospace"
                                android:paddingStart="7dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="7dp"
                                android:paddingBottom="2dp"
                                android:text="TIER 3"
                                android:textColor="@color/accent_green"
                                android:textSize="10sp" />
                        </RelativeLayout>

                        <EditText
                            android:id="@+id/etGroqApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="monospace"
                            android:hint="Groq API Key (gsk_...)"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="10dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="ⓘ Optional. Condenses context into 1 clean sentence in notifications (Llama 3.1 8B, free tier). Audio stays local."
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Audio Capture Stream Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Audio Capture Stream"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="monospace"
                                android:text="ROUTE_V2"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10sp" />
                        </RelativeLayout>

                        <RadioGroup
                            android:id="@+id/rgAudioSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">

                            <RadioButton
                                android:id="@+id/rbMic"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/accent_green"
                                android:checked="true"
                                android:paddingStart="6dp"
                                android:text="Microphone (Room audio input)"
                                android:textColor="@color/text_primary"
                                android:textSize="12.5sp" />

                            <RadioButton
                                android:id="@+id/rbInternal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/accent_green"
                                android:paddingStart="6dp"
                                android:text="Internal Playback (MediaProjection loopback)"
                                android:textColor="@color/text_secondary"
                                android:textSize="12.5sp" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. System Access / Permissions Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="System Permissions"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvGrantAllPermissions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_chip_pill"
                                android:paddingStart="9dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="9dp"
                                android:paddingBottom="3dp"
                                android:text="Grant All"
                                android:textColor="@color/accent_green"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPermNotifications"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:text="Notif: ..."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvPermMic"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:text="Mic: ..."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvPermOverlay"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:text="Overlay: ..."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnMiuiPopups"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_input_field"
                            android:paddingStart="12dp"
                            android:paddingTop="9dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="9dp"
                            android:text="Xiaomi/HyperOS: Tap to allow background pop-up windows"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</RelativeLayout>
