<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="0dp" android:color="#00000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
